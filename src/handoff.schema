// handoff version 22
type Header = { version: number, listener: number, lock: number | null, sessions: Array<SessionSnapshot>, popups: PopupsHandoff, panes: Array<PaneHeader>, telemetry: TelemetryStore, editor: EditorHandoff, captures: Captures, };
type PaneHeader = { id: string, fd: number, pid: number, cols: number, rows: number,
journal: Array<Event>, title: string | null, cwd: string | null, cwd_remote: boolean, spawn_cwd: string | null, color_reports: boolean, colors: Array<[number, number, number] | null>, kitty: KittyKeyboard,
pending: number,
input: number, bin: string | null, shell_name: string | null, prompt: number, programs: Array<ProgramRecord>, };
type PopupsHandoff = {
open: Array<PopupSummary>,
starting: Array<StartingHandoff>,
ended: Array<EndedHandoff>, };
type PopupSummary = { id: string, pane_id: string, title: string, };
type StartingHandoff = { popup: PopupSummary, spawn: Spawn, cwd: string | null, };
type Spawn = { command: PopupCommand,
env: Array<[string, string]> | null, };
type PopupCommand = { "exec": Array<string> } | { "shell": string };
type EndedHandoff = { id: string, pane_id: string, outcome: Outcome,
age_ms: bigint, };
type Outcome = { "Exited": number | null } | { "Failed": string } | "NotShown";
type Event = { "Data": number } | { "Size": [number, number] };
type KittyKeyboard = {
stacks: [[number, number, number, number, number, number, number, number], [number, number, number, number, number, number, number, number]], alternate: boolean,
modes: [boolean, boolean, boolean], saved: [boolean, boolean, boolean], };
type ProgramRecord = {
id: string, state: ProgramState, kind: ProgramKind | null, progress: number | null, app: string | null, title: string | null, msg: string | null,
group: number | null, };
type ProgramState = "idle" | "working" | "done" | "blocked" | "error";
type ProgramKind = "permission" | "question" | "auth";
type SessionSnapshot = { id: string, name: string, runtime: Runtime, windows: Array<WindowSnapshot>, active_window: number, };
type WindowSnapshot = { id: string, name: string, panes: Array<PaneSnapshot>, active_pane: number, layout: Layout, zoomed_pane: string | null, };
type PaneSnapshot = { id: string, title: string | null, cwd: string | null,
cwd_remote: boolean, agent_status: AgentStatus,
agent_id: number | null,
agent_since: number | null, unread: PaneAlert | null, git: PaneGit | null, editor: PaneEditor, };
type PaneEditor = { shown: boolean,
files: Array<string>, active: string | null, };
type PaneGit = {
repo_id: string, repo_name: string, worktree_root: string,
branch: string | null,
main_worktree: boolean, };
type PaneAlert = { level: NotificationLevel, title: string | null, body: string | null, };
type AgentStatus = { state: AgentState, agent: string | null, source: string | null, message: string | null,
background: string | null, };
type AgentState = "unknown" | "idle" | "working" | "waiting" | "blocked" | "done";
type NotificationLevel = "info" | "attention" | "success" | "error";
type Layout = { "type": "leaf", pane_id: string, } | { "type": "v_split", id: string, ratio: number, left: Layout, right: Layout, } | { "type": "h_split", id: string, ratio: number, top: Layout, bottom: Layout, };
type TelemetryStore = { panes: { [key in string]: PaneTelemetry },
closed: Array<ClosedPane>, };
type PaneTelemetry = { series: Array<ModelSeries>, updated_at: bigint, seen_order: Array<bigint>, };
type ModelSeries = { agent: string, model: string | null, buckets: { [key in bigint]: AgentUsage }, };
type AgentUsage = {
input_tokens: number, output_tokens: number, cached_tokens: number, cache_write_tokens: number,
reasoning_tokens: number, requests: number, tool_calls: number, duration_ms: number, cost_usd: number | null, };
type EditorHandoff = {
buffers: Array<HandedBuffer>, servers: HandedServers, };
type HandedBuffer = { id: string, path: Array<number>,
text: string, version: bigint,
log: Array<Update>, saved_version: bigint, line_ending: LineEnding, bom: boolean, disk: Disk, disk_status: DiskStatus, language_id: string | null, };
type Update = { client_id: string,
changes: unknown, };
type HandedServers = { next_id: bigint, servers: Array<HandedServer>, };
type Disk = { stamp: Stamp | null, hash: bigint | null, };
type Stamp = { mtime: [number, number] | null, len: bigint, };
type LineEnding = "lf" | "crlf";
type DiskStatus = "same" | "changed" | "deleted";
type Captures = {
dirs: Array<string>,
files: Array<string>,
popups: Array<PopupCapture>, };
type PopupCapture = { popup: string,
guest: string | null, path: string, };
