{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "allows the bundled startup picker to discover, connect to, start, stop, and upgrade servers, manage remote servers, and match the window background and scheme, and close its window (Cmd+W)",
  "local": true,
  "windows": [
    "*"
  ],
  "permissions": [
    "allow-discover-servers",
    "allow-connect-server",
    "allow-start-server",
    "allow-stop-server",
    "allow-upgrade-server",
    "allow-list-remote-servers",
    "allow-add-remote-server",
    "allow-remove-remote-server",
    "allow-connect-remote-server",
    "allow-zoom",
    "allow-new-window",
    "allow-close-window",
    "allow-set-background",
    "allow-set-color-scheme"
  ]
}
